<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA"/>

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"/>

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_view"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@android:drawable/ic_menu_view"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".ProductScanActivity"
            android:exported="false" />
        <activity
            android:name=".BioMetricAuthActivity"
            android:exported="false" />
        <activity
            android:name=".CloudServicesActivity"
            android:exported="false" />
        <activity
            android:name=".ServicesActivity"
            android:exported="false" />
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name" />
        <activity
            android:name=".DeviceStatusActivity"
            android:label="@string/deviceStatusTitle" />
        <activity
            android:name=".LoginActivity"
            android:label="@string/signInTitle" />
        <activity
            android:name=".PreviewActivity"
            android:label="@string/preview" />
        <activity
            android:name=".DirectorySearchActivity"
            android:label="@string/directorySearch" />
        <activity
            android:name=".ProfileActivity"
            android:label="@string/profileTitle" />
        <activity
            android:name=".ProfileDraftActivity"
            android:label="@string/tempFile" />
        <activity
            android:name=".AccountLoginActivity"
            android:label="@string/activity" />
        <activity
            android:name=".AccountHomeActivity"
            android:exported="true"
            android:label="@string/activity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data
                    android:host="account"
                    android:scheme="mobileapp" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ShowDataReceiver"
            android:enabled="true"
            android:exported="true" />

        <activity
            android:name=".CheckoutActivity"
            android:label="@string/checkout" />
        <activity
            android:name=".DirectoryEditorActivity"
            android:label="@string/directoryTitle" />
        <activity
            android:name=".ScoreActivity"
            android:label="@string/scoreTitle" />
        <activity
            android:name=".TrafficActivity"
            android:label="@string/network" />
        <activity android:name=".ContentProviderActivity" />

        <activity
            android:name=".DeviceInfoActivity"
            android:label="@string/deviceInfoTitle" />
        <activity
            android:name=".ProfileExportActivity"
            android:label="@string/sdCard" />
        <activity
            android:name=".BrowserActivity"
            android:label="@string/wbviewAccess" />
        <activity
            android:name=".ConnectionCheckActivity"
            android:label="@string/connectionCheck" />

        <service
            android:name=".DownloadInvoiceService"
            android:enabled="true"
            android:exported="true" />

        <activity
            android:name=".AdminPanelActivity"
            android:label="@string/AdminPanel" />
        <activity
            android:name=".PaymentCodeActivity"
            android:label="@string/paymentCodeTitle" />
        <activity
            android:name=".ProfileMenuActivity"
            android:label="@string/ProfileMenu" />
        <activity
            android:name=".UtilitiesActivity"
            android:label="@string/UtilitiesMenu" />
        <activity
            android:name=".ToolsActivity"
            android:label="@string/ToolsMenu" />
        <activity
            android:name=".SignInActivity"
            android:label="@string/dict" />
        <activity
            android:name=".AIChatActivity"
            android:label="AI Chat" />

        <provider
            android:name=".ContentProviderActivity"
            android:authorities="com.example.mobileapp.provider.userpinsprovider"
            android:exported="true"/>
    </application>

</manifest>